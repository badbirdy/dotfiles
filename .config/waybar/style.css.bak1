@import "macchiato.css";

* {
  font-family: "CaskaydiaCove Nerd Font", "Font Awesome 6 Free", "LXGW WenKai Mono GB Screen", "polycat";
  font-size: 16px;
  border-radius: 10px;
}

tooltip {
  background: @base;
  border: 1px solid @surface1;
  border-radius: 12px;
}

tooltip label {
  color: @text;
  padding: 6px;
}
menu {
    background: @base;
    border: 1px solid @surface1;
    border-radius: 12px;
    padding: 5px;
}
menuitem {
    border-radius: 8px;
    padding: 5px 8px;
}
menuitem:hover {
    background: @surface0;
}

#waybar {
  border-radius: 12px;
}

#cava {
  margin-top: 5px;
  margin-left: 8px;
  padding-left: 10px;
  padding-right: 10px;
  margin-bottom: 5px;
  border-radius: 10px;
  transition: none;
  background: @base;
  color: @pink;
  transition: 0.3s;
}

#cava:hover {
  color: @base;
  background: @pink;
}

#tray {
  margin-top: 5px;
  margin-left: 8px;
  margin-bottom: 5px;
  padding-left: 10px;
  padding-right: 10px;
  border-radius: 8px;
  background-color: @base;
  border-bottom: 3px;
  border-style: solid;
  border-color: @blue;
}

#custom-weather {
  margin-top: 5px;
  margin-left: 8px;
  margin-bottom: 5px;
  padding-left: 10px;
  padding-right: 10px;
  border-radius: 10px;
  transition: none;
  background: @base;
  color: @maroon;
  padding: 8px;
  border-bottom: 3px;
  border-style: solid;
  border-color: @maroon;
  transition: 0.3s;
}

#custom-weather.weather-hot {
  color: @red;
  border-color: @red;
}

#custom-weather.weather-hot:hover {
  background: @red;
  color: @base;
}

#custom-weather.weather-cold {
  color: @sky;
  border-color: @sky;
}

#custom-weather.weather-cold:hover {
  background: @sky;
  color: @base;
}

#custom-weather.weather-normal {
  color: @lavender;
  border-color: @lavender;
}

#custom-weather.weather-normal:hover {
  background: @lavender;
  color: @base;
}

#custom-weather.weather-error {
  color: @red;
  border-color: @red;
}

#custom-weather.weather-error:hover {
  background: @red;
  color: @base;
}

#pulseaudio {
  margin-top: 5px;
  margin-left: 8px;
  margin-bottom: 5px;
  padding-left: 10px;
  padding-right: 10px;
  border-radius: 10px;
  transition: none;
  background: @base;
  color: @yellow;
  padding: 8px;
  border-bottom: 3px;
  border-style: solid;
  border-color: @yellow;
  transition: 0.3s;
}

#pulseaudio:hover {
  background: @yellow;
  color: @base;
}

#pulseaudio.muted {
  color: @red;
  background: @base;
  border-bottom: 3px;
  border-style: solid;
  border-color: @red;
  transition: 0.3s;
}

#pulseaudio.muted:hover {
  background: @red;
  color: @base;
}

#custom-network {
  margin-top: 5px;
  margin-left: 8px;
  margin-bottom: 5px;
  padding-left: 10px;
  padding-right: 14px;
  border-radius: 10px;
  transition: none;
  background: @base;
  color: @teal;
  border-bottom: 3px;
  border-style: solid;
  border-color: @teal;
  transition: 0.3s;
}

#custom-network:hover {
  color: @base;
  background: @teal;
}

#custom-network.disconnected {
  color: @red;
  background: @base;
  border-bottom: 3px;
  border-style: solid;
  border-color: @red;
}

#custom-network.disconnected:hover {
  background: @red;
  color: @base;
}

#backlight {
  margin-top: 5px;
  margin-left: 8px;
  margin-bottom: 5px;
  padding-left: 10px;
  padding-right: 10px;
  border-radius: 10px;
  transition: none;
  background: @base;
  color: @lavender;
  border-bottom: 3px;
  border-style: solid;
  border-color: @lavender;
  transition: 0.3s;
}

#backlight:hover {
  color: @base;
  background: @lavender;
}

#custom-ddcutil-day {
  margin-top: 10px;
  margin-left: 8px;
  padding-left: 10px;
  padding-right: 10px;
  margin-bottom: 0px;
  border-radius: 10px;
  transition: none;
  background: @base;
  color: @green;
  border-bottom: 3px;
  border-style: solid;
  border-color: @green;
  transition: 0.3s;
}

#custom-ddcutil-night {
  margin-top: 10px;
  margin-left: 8px;
  padding-left: 10px;
  padding-right: 10px;
  margin-bottom: 0px;
  border-radius: 10px;
  transition: none;
  background: @base;
  color: @green;
  border-bottom: 3px;
  border-style: solid;
  border-color: @green;
  transition: 0.3s;
}

#custom-ddcutil-sleep {
  margin-top: 10px;
  margin-left: 8px;
  padding-left: 10px;
  padding-right: 10px;
  margin-bottom: 0px;
  border-radius: 10px;
  transition: none;
  background: @base;
  color: @green;
  border-bottom: 3px;
  border-style: solid;
  border-color: @green;
  transition: 0.3s;
}

#custom-separator\.1 {
  background-color: @surface0;
  color: @overlay2;
  padding: 0px 5px;
}

#backlight-slider {
  margin-top: 10px;
  margin-left: 8px;
  padding-left: 10px;
  padding-right: 10px;
  margin-bottom: 0px;
  border-radius: 10px;
  transition: none;
  background: @base;
  color: @green;
  border-bottom: 3px;
  border-style: solid;
  border-color: @green;
  transition: 0.3s;
  background-color: @surface0;
  padding: 0px 5px 0px 0px;
}

#backlight-slider slider {
  min-height: 0px;
  min-width: 0px;
  opacity: 0;
  background-image: none;
  border: none;
  box-shadow: none;
  background: none;
}

#backlight-slider trough {
  min-height: 10px;
  min-width: 80px;
  border-radius: 5px;
  opacity: 0;
  background-color: @base;
}

#backlight-slider highlight {
  min-width: 10px;
  border-radius: 5px;
  background-color: @blue;
}

#battery {
  margin-top: 5px;
  margin-left: 8px;
  margin-bottom: 5px;
  padding-left: 10px;
  padding-right: 10px;
  border-radius: 10px;
  transition: none;
  background: @base;
  color: @green;
  border-bottom: 3px;
  border-style: solid;
  border-color: @green;
  transition: 0.3s;
}

#battery:hover {
  color: @base;
  background: @green;
}

#battery.charging {
  color: @green;
  border-color: @green;
}

#battery.charging:hover {
  color: @base;
  background: @green;
}

#battery.plugged {
  color: @green;
  border-color: @green;
}

#battery.plugged:hover {
  color: @base;
  background: @green;
}

#battery.warning:not(.charging):not(.plugged) {
  color: @yellow;
  border-color: @yellow;
}

#battery.warning:not(.charging):not(.plugged):hover {
  background: @yellow;
  color: @base;
}

#battery.critical:not(.charging):not(.plugged) {
  color: @red;
  border-color: @red;
}

#battery.critical:not(.charging):not(.plugged):hover {
  background: @red;
  color: @base;
}

#memory {
  margin-top: 5px;
  margin-left: 8px;
  margin-bottom: 5px;
  padding-left: 10px;
  padding-right: 10px;
  border-radius: 10px;
  transition: none;
  background: @base;
  color: @rosewater;
  border-bottom: 3px;
  border-style: solid;
  border-color: @rosewater;
  transition: 0.3s;
}

#memory:hover {
  color: @base;
  background: @rosewater;
}

#custom-lock {
  font-size: 15px;
  margin-top: 5px;
  margin-left: 8px;
  margin-right: 17px;
  margin-bottom: 5px;
  padding-left: 10px;
  padding-right: 5px;
  border-radius: 10px;
  transition: none;
  background: @base;
  color: @blue;
  border-bottom: 3px;
  border-style: solid;
  border-color: @blue;
  transition: 0.3s;
}

#custom-lock:hover {
  background: @maroon;
  color: @base;
  border-color: @maroon;
}

#clock {
  margin-top: 5px;
  margin-left: 8px;
  margin-right: 10px;
  margin-bottom: 5px;
  padding-left: 10px;
  padding-right: 10px;
  border-radius: 10px;
  transition: none;
  background: @base;
  color: @pink;
  border-bottom: 3px;
  border-style: solid;
  border-color: @pink;
  transition: 0.3s;
}

#clock:hover {
  color: @base;
  background: @pink;
}

#disk {
  margin-top: 10px;
  margin-left: 8px;
  padding-left: 10px;
  padding-right: 10px;
  margin-bottom: 0px;
  border-radius: 10px;
  transition: none;
  background: @base;
  color: @blue;
  border-bottom: 3px;
  border-style: solid;
  border-color: @blue;
  transition: 0.3s;
}

#disk:hover {
  color: @base;
  background: @blue;
}

#privacy {
  margin-top: 10px;
  margin-left: 8px;
  padding-left: 10px;
  padding-right: 10px;
  margin-bottom: 0px;
  border-radius: 10px;
  transition: none;
  background: @base;
  color: @blue;
  border-bottom: 3px;
  border-style: solid;
  border-color: @blue;
  transition: 0.3s;
}

#custom-colorpicker {
  margin-top: 5px;
  margin-left: 8px;
  margin-right: 1px;
  margin-bottom: 5px;
  padding-left: 8px;
  padding-right: 12px;
  border-radius: 10px;
  transition: none;
  background: @base;
  color: @subtext0;
  border-bottom: 3px;
  border-style: solid;
  border-color: @subtext0;
  transition: 0.3s;
}

#custom-wfrec {
  margin-top: 5px;
  margin-left: 8px;
  margin-right: 1px;
  margin-bottom: 5px;
  padding-left: 8px;
  padding-right: 12px;
  border-radius: 10px;
  transition: none;
  background: @base;
  color: @subtext0;
  border-bottom: 3px;
  border-style: solid;
  border-color: @subtext0;
  transition: 0.3s;
}

#power-profiles-daemon {
  margin-top: 5px;
  margin-left: 8px;
  margin-right: 1px;
  margin-bottom: 5px;
  padding-left: 8px;
  padding-right: 12px;
  border-radius: 10px;
  transition: none;
  background: @base;
  color: @subtext0;
  border-bottom: 3px;
  border-style: solid;
  border-color: @subtext0;
  transition: 0.3s;
}

#power-profiles-daemon.performance {
  color: @red;
  border-color: @red;
}

#power-profiles-daemon.performance:hover {
  background: @red;
  color: @base;
  border-color: @red;
}

#power-profiles-daemon.balanced {
  color: @subtext0;
  border-color: @subtext0;
}

#power-profiles-daemon.balanced:hover {
  background: @subtext0;
  color: @base;
  border-color: @subtext0;
}

#power-profiles-daemon.power-saver {
  color: @green;
  border-color: @green;
}

#power-profiles-daemon.power-saver:hover {
  background: @green;
  color: @base;
  border-color: @green;
}

#idle_inhibitor {
  margin-top: 5px;
  margin-left: 8px;
  margin-bottom: 5px;
  padding-left: 8px;
  padding-right: 15px;
  border-radius: 10px;
  transition: none;
  background: @base;
  color: @subtext0;
  border-bottom: 3px;
  border-style: solid;
  border-color: @subtext0;
  transition: 0.3s;
}

#idle_inhibitor.activated {
  color: @subtext0;
  border-color: @subtext0;
}

#idle_inhibitor.activated:hover {
  background: @subtext0;
  color: @base;
  border-color: @subtext0;
}

#idle_inhibitor.deactivated {
  color: @subtext0;
}

#idle_inhibitor.deactivated:hover {
  color: @base;
  background: @subtext0;
}

#cpu {
  margin-top: 10px;
  margin-left: 8px;
  margin-bottom: 0px;
  padding-left: 10px;
  padding-right: 10px;
  border-radius: 10px;
  transition: none;
  background: @base;
  color: @blue;
  border-bottom: 3px;
  border-style: solid;
  border-color: @blue;
  transition: 0.3s;
}

#cpu:hover {
  color: @base;
  background: @blue;
}

#custom-powermenu {
  font-size: 20px;
  margin-top: 5px;
  margin-left: 10px;
  margin-bottom: 5px;
  padding-left: 8px;
  padding-right: 14px;
  border-radius: 10px;
  transition: none;
  color: @blue;
  border-bottom: 3px;
  border-style: solid;
  border-color: @blue;
  background: @base;
  transition: 0.3s;
}

#custom-powermenu:hover {
  background: @blue;
  color: @base;
}

#menuitem {
  border-radius: 10px;
}

#workspaces {
  font-family: "FiraCode Nerd Font Mono";
  margin-top: 5px;
  margin-left: 8px;
  margin-bottom: 5px;
  padding-right: 4px;
  background: @base;
  background-color: @base;
  border-bottom: 3px;
  border-style: solid;
  border-color: @blue;
  color: @blue;
  transition: 0.3s;
}

#workspaces button {
  color: @overlay0;
  background: transparent;
  background-color: transparent;
  box-shadow: none;
  margin: 0 2px;
  min-width: 0;
  padding: 0 4px;
  transition: 0.3s;
}

#workspaces button label {
  background: transparent;
  background-color: transparent;
  padding: 0;
}

#workspaces button:hover {
  background: transparent;
  background-color: transparent;
  color: @text;
}

#workspaces button.active {
  background: transparent;
  background-color: transparent;
  color: @blue;
  transition: 0.3s;
}

#window {
  font-weight: 500;
  font-style: italic;
  margin-top: 5px;
  margin-left: 8px;
  margin-bottom: 5px;
  padding-left: 8px;
  padding-right: 8px;
  background: @base;
  background-color: @base;
  border-bottom: 3px;
  border-style: solid;
  border-color: @blue;
  color: @blue;
  transition: 0.3s;
}

#window:hover {
  background: @blue;
  background-color: @blue;
  color: @base;
}

#custom-music {
  font-family: "CaskaydiaCove Nerd Font","LXGW WenKai Mono GB Screen";
  font-weight: bold;
  margin-top: 5px;
  margin-left: 8px;
  margin-bottom: 5px;
  padding-top: 3px;
  padding-left: 8px;
  padding-right: 8px;
  background: @base;
  border-bottom: 3px;
  border-style: solid;
  border-color: @lavender;
  color: @lavender;
  transition: 0.3s;
}

#custom-music:hover {
  background: radial-gradient(circle, rgba(137,180,250,120) 0%, rgba(142,179,250,120) 6%, rgba(148,226,213,1) 14%, rgba(147,178,250,1) 14%, rgba(155,176,249,1) 18%, rgba(245,194,231,1) 28%, rgba(158,175,249,1) 28%, rgba(181,170,248,1) 58%, rgba(205,214,244,1) 69%, rgba(186,169,248,1) 69%, rgba(195,167,247,1) 72%, rgba(137,220,235,1) 73%, rgba(198,167,247,1) 78%, rgba(203,166,247,1) 100%);
  background-size: 400% 400%;
  animation: gradient_f 9s cubic-bezier(.72,.39,.21,1) infinite;
  text-shadow: 0 0 5px rgba(0, 0, 0, 0.377);
  font-weight: bold;
  color: @text;
}

#custom-polycat {
  margin-top: 5px;
  margin-left: 8px;
  margin-bottom: 5px;
  padding-left: 6px;
  padding-right: 4px;
  background: @base;
  border-bottom: 3px;
  border-style: solid;
  border-color: @pink;
  color: @flamingo;
  transition: 0.3s;
}

#custom-polycat label {
  font-size: 28px;
}

#custom-polycat:hover {
  background: @flamingo;
  color: @base;
}

/* AI usage monitors — shared color coding */
#custom-claude-usage {
  padding: 0 8px;
  margin: 0 4px;
  border-radius: 4px;
  background: transparent;
  font-weight: 500;
  transition: all 0.3s ease;
}

#custom-claude-usage:hover {
  background: rgba(222, 115, 86, 0.15);
}

#custom-claude-usage.claude-low {
  color: @green;
}

#custom-claude-usage.claude-mid {
  color: @yellow;
}

#custom-claude-usage.claude-high {
  color: @maroon;
}

#custom-codex-usage {
  margin-top: 5px;
  margin-left: 8px;
  margin-bottom: 5px;
  padding-left: 10px;
  padding-right: 10px;
  border-radius: 10px;
  background: @base;
  color: @teal;
  border-bottom: 3px;
  border-style: solid;
  border-color: @teal;
  font-weight: 500;
  transition: 0.3s;
}

#custom-codex-usage:hover {
  background: @teal;
  color: @base;
}

#custom-codex-usage.codex-low {
  color: @green;
  border-color: @green;
}

#custom-codex-usage.codex-low:hover {
  background: @green;
  color: @base;
}

#custom-codex-usage.codex-mid {
  color: @yellow;
  border-color: @yellow;
}

#custom-codex-usage.codex-mid:hover {
  background: @yellow;
  color: @base;
}

#custom-codex-usage.codex-high {
  color: @maroon;
  border-color: @maroon;
}

#custom-codex-usage.codex-high:hover {
  background: @maroon;
  color: @base;
}

#custom-codex-usage.critical {
  color: @red;
  border-color: @red;
}

#custom-codex-usage.critical:hover {
  background: @red;
  color: @base;
}

#custom-copilot-usage {
  padding: 0 8px;
  margin: 0 4px;
  border-radius: 4px;
  background: transparent;
  font-weight: 500;
  transition: all 0.3s ease;
}

#custom-copilot-usage:hover {
  background: rgba(139, 92, 246, 0.15);
}

#custom-copilot-usage.copilot-low {
  color: @green;
}

#custom-copilot-usage.copilot-mid {
  color: @yellow;
}

#custom-copilot-usage.copilot-high {
  color: @maroon;
}

#custom-zen-balance {
  padding: 0 8px;
  margin: 0 4px;
  border-radius: 4px;
  background: transparent;
  font-weight: 500;
  transition: all 0.3s ease;
}

#custom-zen-balance:hover {
  background: rgba(116, 170, 156, 0.15);
}

#custom-zen-balance.zen-high {
  color: @green;
}

#custom-zen-balance.zen-medium {
  color: @yellow;
}

#custom-zen-balance.zen-low {
  color: @maroon;
}

/* Error state shared across AI monitors */
#custom-claude-usage.critical,
#custom-copilot-usage.critical,
#custom-zen-balance.critical {
  color: @red;
  background: rgba(255, 85, 85, 0.1);
}
